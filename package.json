{
    "name": "bundle-badge",
    "private": true,
    "description": "Minified and gzipped bundle-size badges for npm packages, served from a Cloudflare Worker",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint -c .oxlintrc.json src test",
        "test": "vitest run",
        "tsc": "tsc --noEmit"
    },
    "dependencies": {
        "@oxc-minify/binding-wasm32-wasip1": "0.158.0",
        "semver": "^7.8.6"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261113.1",
        "@types/node": "^26.6.6",
        "@types/semver": "^7.8.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0",
        "wrangler": "^4.162.0"
    }
}
